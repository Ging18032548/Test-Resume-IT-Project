# ==============================================================
# LearnAce Automation — Local Environment (ค่าจริงของเครื่องนี้)
# ไฟล์นี้ถูก gitignore ไว้แล้ว — ห้าม commit ขึ้น repo
#
# ข้อควรระวัง (พิสูจน์จาก unit test วันที่ 2026-10-27):
#   - ค่าที่มีอักขระ # หรือ $ ต้องครอบด้วยเครื่องหมายคำพูด "..." เสมอ
#     มิฉะนั้น dotenv จะตัดทุกอย่างหลัง # ทิ้ง (รหัสผ่านจะเสด็จ!)
#   - ห้ามตั้ง BASE_URL ในไฟล์นี้ (dotenv จะ override การทดสอบ config
#     และทำให้ default ไม่ชี้เว็บจริง) — ระบุ BASE_URL ตอนสั่งรันแทน
# ==============================================================

# โหมด Mocked Persistence — true = ไม่มีข้อมูลใดเข้า backend จริง
MOCK_API=false

# --------------------------------------------------------------
# รหัสผ่านบัญชีทีมงาน 3 คน (ใช้กับชุดเทสต์ TEAM-ADM / TEAM-REAL)
# โหมด MOCK: mock ไม่ตรวจรหัสผ่านจริง แต่ค่านี้ต้องผ่าน password policy
# โหมดจริง (MOCK_API=false): ต้องตรงกับที่ตั้งไว้บนระบบจริง
# --------------------------------------------------------------
TEAM_KANYARAT_PASSWORD="KanyaratHr#99$"
TEAM_PHIRAPHAT_PASSWORD="PhiraphatFin*88_"
TEAM_VARIN_PASSWORD="VarinDesign#55+"

# --------------------------------------------------------------
# บัญชี QA จริงบน learnace.tech (เติมเมื่อได้บัญชีที่มี role ADMIN จริง)
# ใช้กับชุด TC-AUTH-REAL / การดูข้อมูลจริงบน learnace.tech/admin
# --------------------------------------------------------------
TEST_EMAIL=
TEST_PASSWORD=

# วาล์วกันพลาด: ห้ามเปิด true จนกว่าจะได้รับอนุญาตให้สมัครบัญชีจริงบน production
ALLOW_REGISTRATION_TEST=false

# วิธีรันโหมด offline (แอปจำลอง) — ระบุ BASE_URL ตอนสั่งรัน เช่น:
#   BASE_URL=http://127.0.0.1:4310 npx playwright test --project="Desktop Chrome"